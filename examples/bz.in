&bz                                  
  chi_file = 'chi_6.4521_300.dat'    ! result of lindhard_chi.x (or a chi_k<i>_..._.dat k-resolved file)
  nscf_out = 'nscf.out'              ! any pw.x output of the crystal: alat and the crystal axes (the cell)
  ! a1 = 3.6 0.0 0.0                 ! instead of nscf_out: lattice vectors, cartesian, Angstrom ...
  ! a2 = 0.0 10.1 0.0                ! ...
  ! a3 = 0.0 0.0 13.8                ! ...

  plane  = 'ab'                      ! 3D meshes: 'ab' (H K plane), 'bc' (K L) or 'ac' (H L); 2D and 1D: automatic
  k3     = 0.0                       ! 3D meshes: the fixed crystal coordinate (k3 for 'ab', k1 for 'bc', k2 for 'ac');
                                     ! a value c /= 0 writes both planes, +c and -c, into one file
  ! zone_shape = 'auto'              ! auto: the box -1/2 ... 1/2 for monoclinic/triclinic, else Wigner-Seitz
  zone   = 'extended'                ! 'extended': neighbouring zones too; 'first': the first zone only
  extent = 1.0                       ! 'extended': the map covers -extent ... +extent (crystal coordinates)
  ! prefix = 'zrte3_hk0'             ! start of the output names (default: chi file name + _ab / _line)

  ! points to mark (crystal coordinates H K L; fractions allowed): high-symmetry points ...
  G = 0.0 0.0 0.0, Y = 0.0 0.5 0.0   ! label = k1 k2 k3; several on a line are separated by commas
  B = 0.5 0.0 0.0                    ! ...
  D = 0.5 0.5 0.0                    ! ...
  ! ... and q-vectors seen in an experiment, to compare with the maxima of chi0
  ! qcdw = 0.5 0.0 1/3              ! e.g. a CDW q-vector from diffuse X-ray scattering
/                                    ! end of &bz
! plot:   python3 plot_bz.py (asks for the settings, writes a PDF)
